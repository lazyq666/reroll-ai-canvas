# Reroll starts in local-only mode.
# Set to 0.0.0.0 only when you intentionally allow LAN access.
INFINITE_CANVAS_HOST=127.0.0.1

# Prefer port 3000. The launcher automatically tries the next available port.
INFINITE_CANVAS_PORT=3000

# Device State and cache are isolated by source directory by default.
# Explicit paths disable that automatic isolation; normal users leave them empty.
INFINITE_CANVAS_STATE_DIR=
INFINITE_CANVAS_CACHE_DIR=
# Accounts/sessions are shared by local source directories unless overridden.
INFINITE_CANVAS_INSTANCE_STATE_DIR=

# Optional browser origins allowed to send credentialed requests.
INFINITE_CANVAS_ALLOWED_ORIGINS=

# Maximum active realtime client connections to one Smart Canvas.
INFINITE_CANVAS_REALTIME_CONNECTION_LIMIT=20

# Smart Canvas Presence pointer interval in milliseconds (50-500).
# The server batches at most half this interval; restart after changing it.
INFINITE_CANVAS_PRESENCE_UPDATE_INTERVAL_MS=100

# Enable Secure cookies only behind HTTPS.
AUTH_COOKIE_SECURE=0

# Optional local account controls.
AUTH_ALLOW_REGISTRATION=1
AUTH_MAX_ACCOUNTS=40

# Optional upload limits in bytes/count. Restart the service after changing them.
INFINITE_CANVAS_MAX_UPLOAD_FILES=50
INFINITE_CANVAS_MAX_UPLOAD_BYTES=524288000
INFINITE_CANVAS_MAX_WORKFLOW_ARCHIVE_BYTES=524288000
INFINITE_CANVAS_MAX_WORKFLOW_EXTRACTED_BYTES=524288000

# Smart Matting local capacity. Restart the service after changing these values.
# Run admin-tools/抠图并行容量测试-macOS.command before raising concurrency.
MATTING_MAX_CONCURRENCY=2
MATTING_QUEUE_MAX=24
MATTING_PER_USER_MAX=3
MATTING_CPU_THREADS=2
MATTING_REFINE_MAX_PIXELS=1500000
MATTING_MAX_SOURCE_PIXELS=40000000
